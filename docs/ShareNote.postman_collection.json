{
  "info": {
    "name": "ShareNote - Complete API Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Covers all 15 CRUD operations and HTTP 400, 404, 409, and 422 errors. Start the API, then run the entire collection in order with 1 iteration and 0 ms delay. Choose the ShareNote - Local environment or use the collection baseUrl default. Resource IDs are captured automatically. The final folder deletes only resources created by this run. Run the complete collection, not individual folders. Interrupted runs may leave demo records behind."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Create demo resources",
      "item": [
        {
          "name": "Create organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/organizations",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman organization\", \"description\": \"Automated demonstration\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear previous run IDs before creating a new resource hierarchy.",
                  "['orgId', 'groupId', 'noteId'].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orgId\", pm.response.json().id);",
                  "pm.test(\"Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(pm.request.url.getPath() + \"/\" + pm.response.json().id));",
                  "pm.test(\"Created fields\", () => { const expected = JSON.parse(pm.variables.replaceIn(pm.request.body.raw)); for (const [key, value] of Object.entries(expected)) pm.expect(pm.response.json()[key]).to.eql(value); });",
                  "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
                  "pm.test(\"Positive resource ID\", () => { pm.expect(pm.response.json().id).to.be.a(\"number\"); pm.expect(pm.response.json().id).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/groups",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman group\",\"description\":\"Automated demonstration\",\"organizationId\":{{orgId}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
