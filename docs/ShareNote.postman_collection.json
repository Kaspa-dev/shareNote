{
  "info": {
    "name": "ShareNote – visi 15 metodų ir klaidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Paleisti visą kolekciją eilės tvarka, 1 iteracija, 0 ms delay. Kuriami ir ištrinami tik šio paleidimo resursai. API turi veikti prieš paleidžiant."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 Sukurti organizaciją",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/organizations",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman organizacija\", \"description\": \"Demonstracija\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Content-Type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"orgId\", pm.response.json().id);",
              "pm.test(\"Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(pm.request.url.getPath() + \"/\" + pm.response.json().id));"
            ]
          }
        }
      ]
    },
