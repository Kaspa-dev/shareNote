  "components": {
    "schemas": {
      "OrganizationInput": {
        "required": [
          "description",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
            "example": "KTU Faculty of Informatics"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "example": "A collaboration space for students"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "NoteInput": {
        "required": [
          "category",
          "content",
          "groupId",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
            "example": "HTTP methods"
          },
          "content": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string",
            "example": "GET reads, POST creates, PUT replaces, DELETE removes."
          },
          "category": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "example": "REST"
          },
          "groupId": {
            "minimum": 1,
            "type": "integer",
            "format": "int64",
            "example": 1
          }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "groupId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GroupInput": {
        "required": [
          "description",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
            "example": "Web Technologies"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "example": "Course notes and laboratory assignments"
          },
          "organizationId": {
            "minimum": 1,
            "type": "integer",
            "description": "Organization ID, or null for a standalone group",
            "format": "int64",
            "nullable": true,
            "example": 1
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "organizationId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Credentials": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "pattern": "[A-Za-z0-9_.-]{3,80}",
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 12,
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "integer",
            "format": "int64",
            "description": "Absolute refresh expiry in Unix milliseconds"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
