@startuml
title ShareNote – UML diegimo diagrama (Azure konfigūracija)
node "Naudotojo įrenginys" <<device>> {
  node "Naršyklė" <<executionEnvironment>> as browser {
    artifact "React SPA (JavaScript / CSS)"
  }
}
node "Azure Linux VM" <<device>> {
  node "Docker Engine / Compose tinklas" <<executionEnvironment>> {
    node "gateway : Caddy 2\nTCP 80 / 443" <<container>> as gateway
    node "frontend : Nginx\nTCP 80" <<container>> as frontend {
      artifact "Vite dist/"
    }
    node "api : Java 21 / Spring Boot 3.5.5\nTCP 8080" <<container>> as api {
      artifact "ShareNote JAR / Flyway migracijos"
    }
    node "db : PostgreSQL 17\nTCP 5432" <<container>> as db
  }
  artifact "postgres-data (Docker volume)" as volume
}
browser -- gateway : HTTPS / 443 (80 → HTTPS)
gateway -- frontend : HTTP / 80
gateway -- api : HTTP / 8080 (Swagger / OpenAPI)
frontend -- api : HTTP / 8080 (/api/*, JSON, Bearer JWT)
api -- db : JDBC / TCP 5432
db -- volume : duomenų saugojimas
@enduml
